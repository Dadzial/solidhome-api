{
  "name": "solid-home-api",
  "version": "1.0.0",
  "description": "Api for SmartHome",
  "main": "dist/lib/index.js",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "watch": "nodemon",
    "dev": "ts-node ./lib/index.ts",
    "build": "tsc",
    "start": "node dist/lib/index.js",
    "format": "prettier --write \"lib/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"lib/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "author": "Damian Duszak",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "6.0.0",
    "body-parser": "2.4.0",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.22.1",
    "express-rate-limit": "8.7.1",
    "joi": "18.3.1",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.1",
    "morgan": "1.12.1",
    "nodemailer": "10.1.4",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bcrypt": "6.0.0",
    "@types/body-parser": "1.19.6",
    "@types/cors": "2.8.13",
    "@types/express": "4.17.17",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.4",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "mongodb-memory-server": "11.3.0",
    "nodemon": "2.0.22",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "ts-node": "10.9.1",
    "typescript": "5.1.6",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
